# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/chat-app

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (Next.js app) - used for CORS + socket.io + reset-password links
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Email (Gmail example - use an App Password, not your normal password)
USER=your-gmail-address@gmail.com
PASS=your-gmail-app-password

# Google OAuth (Google Cloud Console -> OAuth 2.0 Client ID -> Web application)
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
