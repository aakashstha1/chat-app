# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/chat-app

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (Next.js app) - used for CORS + socket.io + reset-password links
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET_KEY=replace_with_a_long_random_secret

# Email (Gmail example - use an App Password, not your normal password)
USER=your-gmail-address@gmail.com
PASS=your-gmail-app-password

# Google OAuth (Google Cloud Console -> OAuth 2.0 Client ID -> Web application)
# Authorized JavaScript origin: http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- AI Assistant -----------------------------------------------------
# Which LLM provider to use: groq | openai | anthropic | gemini
AI_PROVIDER=groq
# Provider-specific model name, e.g. "llama-3.3-70b-versatile" (Groq),
# "gpt-4o-mini" (OpenAI), "claude-sonnet-4-6" (Anthropic), "gemini-2.5-flash" (Gemini)
AI_MODEL=llama-3.3-70b-versatile
# Never exposed to the frontend - only used server-side in ai.provider.js
AI_API_KEY=your-provider-api-key
# How many recent messages to send as context to the LLM
AI_CONTEXT_MESSAGES=20
# Abort a provider request after this many ms
AI_TIMEOUT_MS=15000
# Per-user rate limit for POST /api/ai/chat
AI_RATE_LIMIT=20
AI_RATE_LIMIT_WINDOW=60000
